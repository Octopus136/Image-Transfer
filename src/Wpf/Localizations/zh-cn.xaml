<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Title -->
    <sys:String x:Key="RootViewTitle">图片大小转换工具</sys:String>

    <!-- UI -->
    <sys:String x:Key="LanguageLabel">语言</sys:String>
    <sys:String x:Key="InputFileLabel">输入文件</sys:String>
    <sys:String x:Key="OutputFileLabel">输出文件</sys:String>
    <sys:String x:Key="BrowseButton">浏览...</sys:String>
    <sys:String x:Key="TargetSizeLabel">目标大小</sys:String>
    <sys:String x:Key="AboutButton">关于</sys:String>
    <sys:String x:Key="StartConvertButton">开始转换</sys:String>

    <!-- content -->
    <sys:String x:Key="AdvancedOptionsContent">高级选项（实验性）</sys:String>
    <sys:String x:Key="UseExperimentalStrategyContent">使用实验性策略</sys:String>
    <sys:String x:Key="UseCUDAContent">使用 CUDA 加速</sys:String>
    <sys:String x:Key="UseCustomJpegQualityContent">使用自定义 JPEG 编码质量</sys:String>
    <sys:String x:Key="UseCustomPngCompressionContent">使用自定义 PNG 压缩级别</sys:String>
    
    <!-- tooltip -->
    <sys:String x:Key="TargetSizeTooltip" xml:space="preserve">请输入正数
1 MB = 1024 KB
实际输出大小与目标大小的相对误差小于 1% 即视为转换成功</sys:String>
    
    <sys:String x:Key="UseExperimentalStrategyTooltip" xml:space="preserve">允许使用实验性策略，该策略大概率能降低耗时，但也有小概率适得其反
本功能还在开发，暂时禁用</sys:String>
    
    <sys:String x:Key="UseCUDATooltip" xml:space="preserve">允许使用 CUDA 加速，必须拥有支持 CUDA 的设备
本功能还在开发，暂时禁用</sys:String>

    <sys:String x:Key="UseCustomJpegQualityTooltip" xml:space="preserve">允许设置自定义 JPEG 质量参数，在处理 PNG 图像时该参数将被忽略
允许值：1（最差） - 100（最好）
过小的质量可能会导致图像出现明显的块状压缩伪影
默认值：95</sys:String>

    <sys:String x:Key="UseCustomPngCompressionTooltip" xml:space="preserve">允许设置自定义 PNG 压缩等级参数，在处理 JPEG 图像时该参数将被忽略
允许值：0（最快，最大） - 9（最慢，最小）
PNG 压缩等级不会影响图像画质，压缩等级越大可能会导致显著的运行时长增加，但也可以显著减小文件体积
默认值：1</sys:String>


    <!-- Models -->
    
    <!-- maybe unused -->
    <sys:String x:Key="TargetSizeErrorRequired">请输入目标大小</sys:String>
    <sys:String x:Key="TargetSizeErrorInvalidNumber">请输入大于 0 的数字，例如 1.5</sys:String>
    <sys:String x:Key="InputOutputMissing">未选择输入与输出路径</sys:String>
    <sys:String x:Key="InvalidTargetSize">目标大小不是合法数字</sys:String>

    <!-- filter -->
    <sys:String x:Key="ImageFileFilter">图片文件|*.png;*.jpg;*.jpeg|所有文件|*.*</sys:String>
    
    <!-- messagebox -->
    <sys:String x:Key="AboutMessage" xml:space="preserve">ImgSizer v2.1 —— 精准控制图片大小，轻松满足各类上传限制。
作者：_Burnside
本软件基于 MIT 协议开源。若您为本软件付费，请尽快与出售方联系。项目地址：https://github.com/Burnside999/ImgSizer</sys:String>
    <sys:String x:Key="AboutTitle">关于</sys:String>
    <sys:String x:Key="ConversionSuccess">转换成功</sys:String>
    <sys:String x:Key="ConversionFailedWithReasonFormat">转换失败：{0}</sys:String>

    <!-- reason -->
    <sys:String x:Key="ReasonSize">目标大小太大，请控制输出大小在原始大小的 10 倍以内</sys:String>
    <sys:String x:Key="ReasonCodecs">内部编解码错误，请尝试减小目标大小与传入图像大小的差距，或尝试其他图像格式</sys:String>
    <sys:String x:Key="ReasonParams">输入路径或目标大小有误，请检查传入参数</sys:String>
    <sys:String x:Key="ReasonUnknown">内部未知错误，请联系开发者</sys:String>
</ResourceDictionary>
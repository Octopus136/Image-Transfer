<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  HandyControl Brush  -->
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="#7F000000" />

    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="RegionBrushOpacity25" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="RegionBrushOpacity50" Color="#7FFFFFFF" />
    <SolidColorBrush x:Key="RegionBrushOpacity75" Color="#BFFFFFFF" />

    <SolidColorBrush x:Key="MouseOverRegionBrush" Color="#f3f3f3" />
    <SolidColorBrush x:Key="MouseOverRegionBrushOpacity25" Color="#40EEEEEE" />
    <SolidColorBrush x:Key="MouseOverRegionBrushOpacity50" Color="#7FEEEEEE" />
    <SolidColorBrush x:Key="MouseOverRegionBrushOpacity75" Color="#BFEEEEEE" />
</ResourceDictionary>
